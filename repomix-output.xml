                {/* Chip — especialistas */}
                <div className="absolute top-4 right-4 bg-white/90 backdrop-blur-sm px-3 py-2 rounded-xl shadow-md flex items-center gap-2"
                  style={{ border: `1px solid ${C.pink100}` }}>
